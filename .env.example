# Copy to .env for local development. NEVER commit .env or put real keys in this file.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# PostgreSQL connection string (local docker compose default shown).
# Hosted DBs (Neon/Supabase/Render): paste their connection string and set DATABASE_SSL=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sat_tutor
DATABASE_SSL=false
DB_POOL_MAX=10

# AI tutor (get a key at https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Email (https://resend.com). Needs a VERIFIED DOMAIN to email the public.
RESEND_API_KEY=
EMAIL_FROM="SAT Tutor <noreply@yourdomain.com>"

# --- Public deployment settings ---
# Public https URL of your site (used in verification/reset email links)
APP_BASE_URL=http://localhost:3000
# true = users must click an emailed link before logging in. Set false ONLY if you have no verified email domain yet.
REQUIRE_EMAIL_VERIFICATION=true
# true when running behind a hosting proxy (Render, Railway, Fly, Cloud Run...). Needed for correct IPs / https links.
TRUST_PROXY=true
# Max simultaneous live AI tutor chats kept in memory (each spawns 3 small helper processes). Lower on small servers.
MAX_TUTOR_AGENTS=10

# First-deploy admin account (created by the bootstrap step). Remove ADMIN_PASSWORD after first successful login.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
